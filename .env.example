# Server
PORT=8787
# ESPN event id of the featured game pinned to the top of the home page (PIT @ NO, 2026 wk 7).
FEATURED_GAME_ID=401873011
# Past game used for the polished replay demo (PIT @ TB, 2026 wk 6, OT comeback).
DEMO_GAME_ID=401873002
# Protects POST /api/admin/source (the demo kill switch). Required in production.
ADMIN_TOKEN=change-me

# Optional paid APIs. Missing keys disable the feature, never the app.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
X_BEARER_TOKEN=
ODDS_API_KEY=

# Web (only needed when the web app is hosted separately from the server)
VITE_API_BASE=
